{#-
  One structure for every template; only the stylesheet differs (see catalog.py).
  ATS rules this file keeps, and tests/test_rendering.py checks:
  - a single column in reading order; no tables, no text in images
  - contact details in the body, never in a page header or footer
  - standard section headings, as text
  Everything from the user is autoescaped.
-#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ b.name or "Resume" }} – Resume</title>
{% if b.name %}<meta name="author" content="{{ b.name }}">{% endif %}
<style>
{{ base_css }}
{{ template_css }}
</style>
</head>
<body class="tpl-{{ slug }}">
<main class="page">

<header class="head">
  {% if b.name %}<h1 class="name">{{ b.name }}</h1>{% endif %}
  {% if b.headline %}<p class="headline">{{ b.headline }}</p>{% endif %}
  {% if contact %}
  <p class="contact">
    {%- for item in contact -%}
      {% if not loop.first %}<span class="sep" aria-hidden="true"> · </span>{% endif -%}
      {% if item.href %}<a href="{{ item.href }}">{{ item.text }}</a>{% else %}{{ item.text }}{% endif -%}
    {%- endfor -%}
  </p>
  {% endif %}
</header>

{% if data.summary %}
<section class="section summary">
  <h2>Summary</h2>
  <p>{{ data.summary }}</p>
</section>
{% endif %}

{% if data.experience %}
<section class="section">
  <h2>Experience</h2>
  {% for e in data.experience %}
  <div class="entry">
    <div class="entry-head">
      <span class="what"><strong>{{ e.title }}</strong>{% if e.title and e.company %}, {% endif %}{{ e.company }}{% if e.location %} <span class="where">— {{ e.location }}</span>{% endif %}</span>
      {% set when = date_range(e.start, e.end, e.current) %}{% if when %}<span class="when">{{ when }}</span>{% endif %}
    </div>
    {% if e.bullets %}
    <ul>
      {% for bullet in e.bullets %}<li>{{ bullet.text }}</li>
      {% endfor %}
    </ul>
    {% endif %}
  </div>
  {% endfor %}
</section>
{% endif %}

{% if data.education %}
<section class="section">
  <h2>Education</h2>
  {% for e in data.education %}
  <div class="entry">
    <div class="entry-head">
      <span class="what"><strong>{{ [e.degree, e.field] | select | join(", ") }}</strong>{% if (e.degree or e.field) and e.institution %} — {% endif %}{{ e.institution }}{% if e.location %} <span class="where">— {{ e.location }}</span>{% endif %}</span>
      {% set when = date_range(e.start, e.end, False) %}{% if when %}<span class="when">{{ when }}</span>{% endif %}
    </div>
    {% if e.details %}<p class="details">{{ e.details }}</p>{% endif %}
  </div>
  {% endfor %}
</section>
{% endif %}

{% if data.skills %}
<section class="section skills">
  <h2>Skills</h2>
  {% for g in data.skills %}
  <p>{% if g.group %}<strong>{{ g.group }}:</strong> {% endif %}{{ g["items"] | join(", ") }}</p>
  {% endfor %}
</section>
{% endif %}

{% if data.projects %}
<section class="section">
  <h2>Projects</h2>
  {% for p in data.projects %}
  <div class="entry">
    <div class="entry-head">
      <span class="what"><strong>{{ p.name }}</strong>{% set link = link_for(p.url) %}{% if link %} — {% if link.href %}<a href="{{ link.href }}">{{ link.text }}</a>{% else %}{{ link.text }}{% endif %}{% endif %}</span>
      {% set when = date_range(p.start, p.end, False) %}{% if when %}<span class="when">{{ when }}</span>{% endif %}
    </div>
    {% if p.bullets %}
    <ul>
      {% for bullet in p.bullets %}<li>{{ bullet.text }}</li>
      {% endfor %}
    </ul>
    {% endif %}
  </div>
  {% endfor %}
</section>
{% endif %}

{% if data.certifications %}
<section class="section">
  <h2>Certifications</h2>
  <ul class="plain">
  {% for c in data.certifications %}
    <li><strong>{{ c.name }}</strong>{% if c.issuer %} — {{ c.issuer }}{% endif %}{% set d = format_date(c.date) %}{% if d %}, {{ d }}{% endif %}</li>
  {% endfor %}
  </ul>
</section>
{% endif %}

</main>
</body>
</html>
