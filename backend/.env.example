DATABASE_URL=postgresql+psycopg://resume:resume@localhost:5433/resume
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,chrome-extension://pjddbiflcebndfljpckcgkigckfpmndm
ENVIRONMENT=development
# Required outside development, at least 32 bytes: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# Reads uploaded resumes. Never commit a real key; this file is gitignored as .env.
OPENAI_API_KEY=
# OPENAI_PARSE_MODEL=gpt-4o-mini
# OPENAI_TAILOR_MODEL=gpt-4.1
# The website, for links in emails.
# WEB_URL=http://localhost:3100
# Outgoing email (password reset). Unset: emails are written to the API log instead.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# Behind a proxy that sets X-Forwarded-For (Render, Fly...): true. Otherwise leave false.
# TRUST_PROXY_HEADERS=false
